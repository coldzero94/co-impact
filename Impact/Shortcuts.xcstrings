{
  "sourceLanguage": "en",
  "strings": {
    "Directions to %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 장소로 길 안내를 엽니다."
          }
        }
      }
    },
    "Directions to Next": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 약속 길 안내"
          }
        }
      }
    },
    "Directions to Next Appointment": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 약속 길 안내"
          }
        }
      }
    },
    "Impact can't read your calendar.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Impact가 캘린더를 읽을 수 없습니다."
          }
        }
      }
    },
    "Join Next Meeting": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 회의 참여"
          }
        }
      }
    },
    "Joining %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 회의에 참여합니다."
          }
        }
      }
    },
    "Next: %@, %@. %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 일정은 %2$@, %1$@입니다. %3$@."
          }
        }
      }
    },
    "No appointment with a place today.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 장소가 있는 약속이 없습니다."
          }
        }
      }
    },
    "No meeting with a link today.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 링크가 있는 회의가 없습니다."
          }
        }
      }
    },
    "Nothing needs you today.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 챙길 일정이 없습니다."
          }
        }
      }
    },
    "Opens Impact and joins your next meeting with a link today.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Impact를 열고, 오늘 링크가 있는 다음 회의에 참여합니다."
          }
        }
      }
    },
    "Opens Impact and starts directions to your next appointment today.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Impact를 열고, 오늘 다음 약속 장소까지 길 안내를 시작합니다."
          }
        }
      }
    },
    "Says the next event that needs you, and when.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "챙겨야 할 다음 일정과 시각을 알려 줍니다."
          }
        }
      }
    },
    "What's Next": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 일정"
          }
        }
      }
    }
  },
  "version": "1.0"
}
